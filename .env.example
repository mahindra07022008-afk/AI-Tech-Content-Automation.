# Telugu Tech Storytelling AI Agent — environment template.
# Copy to `.env` (gitignored) and fill only what you need. Never commit real values.

# --- YouTube Data API v3 (optional, for private uploads after approval) ---
# Path to the OAuth 2.0 "Desktop app" client JSON you download from Google Cloud Console.
# Free tier: 10,000 quota units/day. One upload costs ~1,600 units.
YOUTUBE_CLIENT_SECRETS_FILE=data/secrets/client_secret.json
# Token is written here after you complete the consent screen yourself (chmod 600).
YOUTUBE_TOKEN_FILE=data/secrets/youtube_token.json

# --- Gmail daily report (optional; uses the same Google OAuth client, gmail.send scope) ---
GMAIL_TOKEN_FILE=data/secrets/gmail_token.json
# Recipient for daily reports. Leave empty to save reports locally only.
REPORT_EMAIL_TO=

# --- GitHub API (optional; raises research rate limit from 60 to 5,000 req/h) ---
# A fine-grained token with NO scopes (public data only) is enough.
GITHUB_TOKEN=

# --- MoneyPrinterTurbo location (default: vendor/MoneyPrinterTurbo) ---
MPT_HOME=

# --- Claude Code (LLM) ---
# No API key needed: MoneyPrinterTurbo's official `claude_code` provider runs the
# locally logged-in `claude` CLI. In Docker/CI only, export a token from
# `claude setup-token` as CLAUDE_CODE_OAUTH_TOKEN (never commit it).
